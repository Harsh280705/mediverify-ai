# =========================================================================
# MediVerify AI - Backend Environment Template
# Copy this file to '.env' and fill in your values. Never commit real secrets.
# =========================================================================

# Path to Firebase Admin SDK Service Account JSON credentials file
# Place your downloaded JSON file in the 'backend/firebase/' directory
# (e.g., backend/firebase/serviceAccount.json) and set the path relative to the backend root.
SERVICE_ACCOUNT_PATH=firebase/serviceAccount.json

# Firebase Project ID (Found in project settings on Firebase Console)
PROJECT_ID=your-firebase-project-id

# Ollama Local LLM Configuration
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Verification Mode:
# - 'production' (Enforces OCR + visual checkpoints + face/mouth tracking ingestion logic)
# - 'demo' (Uses gesture-based sandbox verification mode)
VERIFICATION_MODE=production
DEMO_MODE=false
